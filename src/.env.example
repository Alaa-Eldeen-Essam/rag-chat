APP_NAME="mini-RAG-Alaa"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["application/pdf","text/plain","text/html","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","image/png","image/jpeg","image/tiff"]
FILE_MAX_SIZE=100  # 100MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100

POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_MAIN_DATABASE="minirag"

######################## LLM Config ##############################

GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"

OPENAI_API_KEY=""
HF_TOKEN=""
HF_HUB_OFFLINE=0
# Default OpenAI-style API endpoints for each local engine
OLLAMA_API_URL="http://172.23.112.1:11434/v1"
VLLM_CHAT_API_URL="http://172.20.32.1:8000/v1"
VLLM_EMBED_API_URL="http://172.20.32.1:8002/v1"

# Backwards-compatible default for code paths that still read OPENAI_API_URL
OPENAI_API_URL="${OLLAMA_API_URL}"

# Role-specific API URLs (can be switched between engines)
GENERATION_API_URL="${OLLAMA_API_URL}"
EMBEDDING_API_URL="${OLLAMA_API_URL}"

# Ollama-specific models (chat + embeddings)
OLLAMA_GENERATION_MODEL_ID="command-r7b-arabic-16k"
OLLAMA_BEST_GENERATION_MODEL_ID="command-r7b-arabic-16k"
OLLAMA_THINKING_GENERATION_MODEL_ID="qwen3:4b-thinking-2507-q4_K_M"
OLLAMA_FAST_GENERATION_MODEL_ID="qwen3:4b-instruct-2507-q4_K_M"
OLLAMA_EMBEDDING_MODEL_ID="paraphrase-multilingual:latest"

# vLLM-specific models (examples; must match what vLLM services use)
VLLM_CHAT_MODEL_NAME="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_EMBED_MODEL_NAME="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_BEST_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_THINKING_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_FAST_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_EMBEDDING_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"


# Default parameters for generation and embedding
INPUT_DAFAULT_MAX_CHARACTERS=8192
GENERATION_DAFAULT_MAX_TOKENS=2048
GENERATION_DAFAULT_TEMPERATURE=0
SUMMARY_DEFAULT_MAX_TOKENS=2048
EMBEDDING_MODEL_SIZE=768
RETRIEVAL_DENSE_WEIGHT=0.6
RAG_HISTORY_WEIGHT=0.75
RAG_HISTORY_MAX_TURNS=8
RAG_HISTORY_FOLLOWUP_SIM_THRESHOLD=0.30
RAG_AMBIGUITY_ENABLED=true
RAG_AMBIGUITY_THRESHOLD=0.12
RAG_AMBIGUITY_TOP_N=4
RAG_FORCE_CLARIFICATION=true
RAG_EVIDENCE_SYNTHESIS_ENABLED=true
RAG_EVIDENCE_SYNTHESIS_MAX_DOCS=8
RAG_MIN_ANSWER_CONFIDENCE=0.20
RAG_GROUNDING_ENABLED=true
RAG_GROUNDING_MIN_CLAIM_OVERLAP=0.20
RAG_GROUNDING_MAX_UNGROUNDED_CLAIMS=1
RAG_GROUNDING_MIN_TOKEN_MATCHES=2

# ========================= Reranker (optional) =========================
RERANKER_ENABLED=true
RERANKER_BACKEND="cross_encoder"
RERANKER_MODEL_ID="/app/models/cross-encoder-msmarco"
RERANKER_FALLBACK_MODEL_ID="cross-encoder/ms-marco-MiniLM-L-6-v2"
RERANKER_MAX_CANDIDATES=10
RERANKER_TIMEOUT=120
OLLAMA_RERANKER_MODEL_ID="dengcao/Qwen3-Reranker-4B:Q4_K_M"
OLLAMA_RERANKER_HOST="http://172.23.112.1:11434"

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL = ["PGVECTOR"]
VECTOR_DB_BACKEND = "PGVECTOR"
# VECTOR_DB_PATH = ""  # Not used for PGVECTOR
VECTOR_DB_DISTANCE_METHOD = "cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD =100

PRIMARY_LANG = "en"
DEFAULT_LANG = "en"

# ========================= OCR / Tesseract =========================
# Enable or disable OCR fallback for scanned PDFs and images.
OCR_ENABLED=true
# Tesseract language packs to use (English + Arabic).
OCR_LANGS="eng+ara"
# Optional: clamp number of pages to OCR for very large PDFs (null = no clamp).
# OCR_MAX_PAGES= 50 
# Rendering DPI for PDF -> image before OCR.
OCR_DPI=500

JWT_SECRET_KEY="a-strong-random-secret"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================= Search / Elasticsearch =========================
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX_PREFIX="minirag"


# ========================= Prompt Guard =========================
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_PYTECTOR=false
PROMPT_GUARD_PYTECTOR_MODEL="deberta"
PROMPT_GUARD_PYTECTOR_THRESHOLD=0.75
PROMPT_GUARD_BYPASS_HEADER="X-Bypass-Prompt-Guard"
DEBUG_INCLUDE_PROMPTS=false

# Multihop defaults
MULTIHOP_MAX_HOPS=2
MULTIHOP_PER_HOP_K=6
MULTIHOP_PER_HOP_EVIDENCE=3
# MULTIHOP_TEMPERATURE=0.0

