APP_NAME="mini-RAG-Alaa"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES=["application/pdf","text/plain","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10  # 10MB
FILE_DEFAULT_CHUNK_SIZE=512000 # 512KB
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
# Multihop RAG defaults
MULTIHOP_MAX_HOPS=2
MULTIHOP_PER_HOP_K=6
MULTIHOP_PER_HOP_EVIDENCE=3
# MULTIHOP_TEMPERATURE=0.0

MONGODB_URL="mongodb://admin:admin123@localhost:27007"
MONGODB_DATABASE="mini-rag"

######################## LLM Config ##############################

GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="COHERE"

OPENAI_API_KEY=""
HF_TOKEN=""
HF_HUB_OFFLINE=0
# Default OpenAI-style API endpoints for each local engine
OLLAMA_API_URL="http://localhost:11434/v1"
VLLM_CHAT_API_URL="http://localhost:8000/v1"
VLLM_EMBED_API_URL="http://localhost:8002/v1"

# Backwards-compatible default for code paths that still read OPENAI_API_URL
OPENAI_API_URL="${OLLAMA_API_URL}"

# Role-specific API URLs (can be switched between engines)
GENERATION_API_URL="${OLLAMA_API_URL}"
EMBEDDING_API_URL="${OLLAMA_API_URL}"

# Ollama-specific models (chat + embeddings)
OLLAMA_GENERATION_MODEL_ID="command-r7b-arabic:7b-02-2025-q8_0"
OLLAMA_BEST_GENERATION_MODEL_ID="command-r7b-arabic:7b-02-2025-q8_0"
OLLAMA_THINKING_GENERATION_MODEL_ID="qwen3:4b-thinking-2507-q4_K_M"
OLLAMA_FAST_GENERATION_MODEL_ID="qwen3:b-instruct-2507-q4_K_M"
OLLAMA_EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"

# vLLM-specific models (examples; must match what vLLM services use)
VLLM_CHAT_MODEL_NAME="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_EMBED_MODEL_NAME="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_BEST_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_THINKING_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_FAST_GENERATION_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
VLLM_EMBEDDING_MODEL_ID="meta-llama/Meta-Llama-3-8B-Instruct"
COHERE_API_KEY=""

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1
EMBEDDING_MODEL_SIZE=384
RETRIEVAL_DENSE_WEIGHT=0.6

# ========================= Reranker (optional) =========================
# Use HTTP/Infinity for best quality (BAAI/bge-reranker-v2-m3), or ollama_cli
RERANKER_ENABLED=false
RERANKER_BACKEND="ollama_cli"
RERANKER_MODEL_ID="BAAI/bge-reranker-v2-m3"
RERANKER_MAX_CANDIDATES=50
RERANKER_TIMEOUT=60
OLLAMA_RERANKER_MODEL_ID="dengcao/Qwen3-Reranker-4B:Q4_K_M"
OLLAMA_RERANKER_HOST="http://localhost:11434"

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND="QDRANT"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"

PRIMARY_LANG = "en"
DEFAULT_LANG = "en"

JWT_SECRET_KEY="change-me-in-dev"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ========================= Search / Elasticsearch =========================
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_INDEX_PREFIX="minirag"

# ========================= Prompt Guard =========================
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_PYTECTOR=false
PROMPT_GUARD_PYTECTOR_MODEL="deberta"
PROMPT_GUARD_PYTECTOR_THRESHOLD=0.75
PROMPT_GUARD_BYPASS_HEADER="X-Bypass-Prompt-Guard"
